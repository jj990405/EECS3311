  <diagram id="03-llm-and-retrieval" name="LLM adapter and grounded retrieval">
    <mxGraphModel dx="1600" dy="1210" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1210">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="LLM adapter and grounded retrieval" style="text;html=1;align=left;fontSize=30;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="30" width="1500" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="External model access is replaceable; source selection and citation checks remain deterministic." style="text;html=1;align=left;fontSize=17;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="82" width="1500" height="35" />
        </mxCell>
        <mxCell id="controller" value="AgentController" style="swimlane;html=1;startSize=44;rounded=0;fillColor=#dbeafe;swimlaneFillColor=#ffffff;strokeColor=#64748b;fontSize=17;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="150" width="430" height="207" />
        </mxCell>
        <mxCell id="controller-body" value="- llm: LlmClient; - prompts: PromptBuilder&lt;br&gt;- parser: ResponseParser; - history: InteractionHistory&lt;hr&gt;+ answerQuestion(...)&lt;br&gt;+ suggestReferences(...)&lt;br&gt;+ generateSummary(...) / generateQuiz(...)" style="text;html=1;align=left;verticalAlign=top;fontSize=16;spacing=10;" vertex="1" parent="controller">
          <mxGeometry as="geometry" x="0" y="44" width="430" height="163" />
