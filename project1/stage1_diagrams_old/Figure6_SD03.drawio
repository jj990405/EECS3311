;html=1;width=50;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="628" width="1620" height="266" as="geometry"/></mxCell><mxCell id="c45" value="[edit or delete: UC04 extend]" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="75" y="628" width="420" height="20" as="geometry"/></mxCell><mxCell id="c46" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=20;fillColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="894" width="1620" height="228" as="geometry"/></mxCell><mxCell id="c47" value="[track progress: UC10]" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="75" y="894" width="420" height="20" as="geometry"/></mxCell><mxCell id="c48" value="Alternative / exception flows and notes:&lt;br&gt;• deleteDeadline(d) follows the same path with DeleteDeadlineCommand&lt;br&gt;• [invalid edit, e.g. date outside the semester] the change is rejected&lt;br&gt;• [no deadlines] the user is told to upload a syllabus; [course without deadlines] the course is listed in StatusBar&lt;br&gt;• [too many items on one day] a summary is shown; [CLI search has no result] &amp;#x27;No results&amp;#x27; is printed&lt;br&gt;• [past deadline not completed] ProgressTracker.findOverdue() result is shown in StatusBar&lt;br&gt;• Order rule: earlier deadline first; on the same date, higher course difficulty first&lt;br&gt;• markCompleted and editDeadline are the user&amp;#x27;s own actions, so no approval step is needed" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1206" width="1100" height="136" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>